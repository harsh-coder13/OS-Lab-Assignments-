//CALULATOR
#!/bin/bash
echo "Enter first number:"
read num1
echo "Enter second number:"
read num2
echo "Choose operation: +  -  *  /"
read op
case $op in
    +) result=$((num1 + num2))
       echo "Result: $result" ;;
    -) result=$((num1 - num2))
       echo "Result: $result" ;;
    \*) result=$((num1 * num2))
        echo "Result: $result" ;;
    /) result=$((num1 / num2))
       echo "Result: $result" ;;
    *) echo "Invalid operation" ;;
esac

